# Copy to .env.local. Only VITE_* values reach the browser — never put secrets here.
# Base URL of the real backend (Base44 or custom). Empty = use the in-browser mock server.
VITE_API_BASE_URL=
# Public label shown on UPI screens (not a secret).
VITE_UPI_PAYEE_NAME=MartIT
# Approved merchant UPI Payee VPA (e.g. omkarrakhonde485@oksbi).
# Leave empty if not yet configured. QR generation safely fails and highlights this configuration requirement.
VITE_UPI_PAYEE_VPA=

# Server-only environment variable (never expose to client or prefix with VITE_).
# Protected endpoint for Make.com payment reconciliation webhook.
MAKE_VERIFICATION_WEBHOOK_URL=
